	# hand-edited over years, mixed styles

PORT=8080   
  HOST = 0.0.0.0     # bind all
export NODE_ENV=production
export   PATH_EXTRA='/opt/bin:/usr/local/bin'
BRAND_COLOR=#ff0000
EMPTY=
EMPTY_WITH_COMMENT= # nothing here
EMPTY_QUOTED=""
URL=https://example.com/a#fragment
GREETING="hello\tworld\n"
LITERAL='no $EXPANSION or \n escapes'
TEMPLATE=`backtick ${HOST} kept`
BASE_URL=http://${HOST}:${PORT}
API_URL="${BASE_URL}/api"
LOG_LEVEL=${LOG_LEVEL:-info}
PRICE="costs \$5"
UNICODE=héllo wörld ✓
dotted.key=ok
PORT=9090
export INHERITED
